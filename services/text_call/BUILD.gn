import("//build/ohos.gni")
import("../../accessibility_manager_service.gni")
 
text_call_path = "./"
 
config("text_call_config") {
  visibility = [ ":*" ]
 
  include_dirs = [
    "inc",
    "../../common/log/include",
  ]
 
  defines = [
    "AAMS_LOG_TAG = \"accessibility\"",
    "AAMS_LOG_DOMAIN = 0xD001D00",
  ]
 
  if (build_variant == "user") {
    defines += [ "RELEASE_VERSION" ]
  }
 
  defines += accessibility_default_defines
}
 
text_call_files = [
  "${text_call_path}/src/accessible_text_call_manager.cpp",
  "${text_call_path}/src/export_api.cpp",
]
 
ohos_shared_library("accessibleTextCall") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
 
  cflags = [
    "-ffunction-sections",
    "-fdata-sections",
  ]
 
  ldflags = [
    "-Wl,--gc-sections",
  ]
 
  sources = text_call_files
 
 
  configs = [
    ":text_call_config",
    "../../resources/config/build:coverage_flags",
  ]
 
  external_deps = [
    "ability_base:zuri",
    "ability_runtime:extension_manager",
    "ability_runtime:wantagent_innerkits",
    "ability_runtime:ability_connect_callback_stub",
    "c_utils:utils",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "ipc:ipc_single"
  ]

  if (accessibility_text_call_support) {
    external_deps += [ "call_manager:tel_call_manager_api" ]
  }
  
  install_enable = true
 
  subsystem_name = "barrierfree"
  part_name = "accessibility"
}